---
// Line icons, 1.5 px: phone, telegram, whatsapp, arrow. Decorative (aria-hidden); the label is always text next to it.
interface Props { name: "phone" | "telegram" | "whatsapp" | "arrow" | "menu" | "close"; size?: number; }
const { name, size = 20 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 4h3.2l1.6 4.2-2 1.3a11 11 0 0 0 6.7 6.7l1.3-2L20 15.8V19a1 1 0 0 1-1 1A15 15 0 0 1 4 5a1 1 0 0 1 1-1z" />}
  {name === "telegram" && <path d="M20.5 4.2 3.6 10.8c-.7.3-.7 1.2 0 1.4l4.3 1.4 1.7 5.2c.2.6 1 .8 1.4.3l2.4-2.3 4.4 3.2c.5.4 1.2.1 1.4-.5l2.9-14c.1-.8-.6-1.4-1.6-1.3zM8 13.4l9.6-6.1" />}
  {name === "whatsapp" && <path d="M4 20l1.2-4.1A8 8 0 1 1 8.300 19L4 20zM9 8.500c0 3.500 3 6.500 6.500 6.500l1-1.600-2-1-.8.800c-1-.4-2-1.400-2.400-2.400l.8-.8-1-2L9 8.500z" />}
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
